PORT=3001
CORS_ORIGIN=*

# Escolha um provedor: openai ou ollama
AI_PROVIDER=ollama

# OpenAI (usado quando AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama local (usado quando AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=120000

# Acesso administrativo inicial (altere a senha antes de disponibilizar o sistema)
ADMIN_EMAIL=admin@acessforge.local
ADMIN_PASSWORD=AcessForge@2026
ADMIN_SESSION_SECRET=troque-por-uma-chave-aleatoria-longa

# Código privado para permitir novos cadastros de administrador (mínimo 16 caracteres)
ADMIN_REGISTRATION_CODE=
